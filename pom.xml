<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>network.onemfive</groupId>
	<artifactId>1m5-core</artifactId>
	<version>0.1.0</version>
	<packaging>jar</packaging>

	<name>1m5-core</name>
	<url>https://1m5.io</url>
	<description>1M5 Core - intelligent censorship-resistant router built on the SEDA and Service buses</description>
	<inceptionYear>2017</inceptionYear>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!--
		  Java 17: matches seda-bus:1.3.0 (already Java 17 bytecode, so a JDK 17+
		  build is required regardless) and the 1m5-android app module (already 17).
		  1m5-desktop-java stays on 11 by depending on a small Java-11 1m5-common
		  (ManCon et al.) rather than on this jar directly - see TODO.md.
		-->
		<maven.compiler.release>17</maven.compiler.release>
	</properties>

	<developers>
		<developer>
			<name>objectorange</name>
			<email>objectorange@1m5.io</email>
		</developer>
	</developers>

	<scm>
		<connection>scm:git@github.com/1m5/1m5-core-java</connection>
		<developerConnection>scm:git@github.com/1m5/1m5-core-java</developerConnection>
		<url>git@github.com/1m5/1m5-core-java</url>
	</scm>

	<repositories>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		  The bus stack, as one chain:
		    1m5-core  ->  service-bus  ->  seda-bus  ->  common
		  service-bus-java is the only layer we depend on directly; it brings
		  seda-bus-java (the SEDA staged bus + routing-slip execution engine) and
		  ra-common (Envelope, DynamicRoutingSlip, Route, BaseService, ServiceLevel)
		  transitively at the versions it was built and tested against.
		-->
		<dependency>
			<groupId>resolvingarchitecture</groupId>
			<artifactId>service-bus</artifactId>
			<version>1.5.0</version>
		</dependency>

		<!--
		  I2P protocol service. Wrapped by network.onemfive.core.protocol.I2PProtocolService
		  and registered by the Daemon only when 1m5.i2p.enabled=true (an embedded I2P
		  router reseeds on first start and takes minutes). Brings net.i2p:i2p / router /
		  streaming / mstreaming.
		-->
		<dependency>
			<groupId>resolvingarchitecture</groupId>
			<artifactId>i2p</artifactId>
			<version>1.7.1</version>
		</dependency>

		<!--
		  Tor protocol service. Wrapped by network.onemfive.core.protocol.TorProtocolService
		  and registered by the Daemon only when 1m5.tor.enabled=true (needs a local Tor
		  daemon). Brings tor-client -> http-client (jetty, okhttp).
		-->
		<dependency>
			<groupId>resolvingarchitecture</groupId>
			<artifactId>tor-client</artifactId>
			<version>1.2.1</version>
		</dependency>

		<!--
		  Added as the corresponding capability is implemented (see TODO.md):
		    resolvingarchitecture:notification  - status/event pub-sub (NotificationService)
		    resolvingarchitecture:did           - legacy OpenPGP identity (read-only, migration)
		    resolvingarchitecture:network-manager - InMemoryPeerDB / P2PRelationship for the router
		    resolvingarchitecture:bluetooth-client - Bluetooth ProtocolService
		    resolvingarchitecture:btc, dex      - Bitcoin business services
		-->

		<!-- Test -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}-${project.version}</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/*.config</include>
					<include>**/*.properties</include>
					<include>**/*.json</include>
					<include>**/*.xml</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.7.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<archive>
						<manifest>
							<mainClass>network.onemfive.core.Daemon</mainClass>
						</manifest>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
