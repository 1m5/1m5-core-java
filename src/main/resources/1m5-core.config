# 1M5 Core configuration
# Loaded by network.onemfive.core.Daemon via ra.common.Config; every value here
# can be overridden on the command line (key=value) or by a supplied Properties.

# --- General -----------------------------------------------------------------
1m5.version=${project.version}
1m5.version.build=1
1m5.systemTimeZone=UTC
1m5.env=dev

# ISO 3166-1 alpha-2 of the user's jurisdiction. If set, the ManCon floor
# (minRequired) is seeded from jurisdictions-levels.txt (RSF World Press Freedom
# Index). Leave unset to keep the built-in default (HIGH). The user can override.
#1m5.jurisdiction=US

# --- SEDA bus --------------------------------------------------------------
# Worker pool size: an integer, or "Platform" for (cores * 2).
ra.sedabus.pool.max=Platform

# --- Protocol services (all opt-in; off by default) -------------------------
#1m5.i2p.enabled=true
#1m5.tor.enabled=true
#1m5.http.enabled=true

# --- Localhost Envelope-JSON API (for 1m5-desktop-java) ---------------------
# Not started by the skeleton Daemon yet - the ADR-0003 RPC handler itself is
# still TODO, though resolvingarchitecture:http-client is now a dependency
# (see TODO.md). Kept here as the intended contract: host,port,handler.
#ra.http.server.configs=1m5-api,api,127.0.0.1,2018,ra.http.EnvelopeJSONDataHandler
