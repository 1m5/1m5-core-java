# 1M5 Core configuration
# Loaded by network.onemfive.core.Daemon via ra.common.Config; every value here
# can be overridden on the command line (key=value) or by a supplied Properties.

# --- General -----------------------------------------------------------------
1m5.version=${project.version}
1m5.version.build=1
1m5.systemTimeZone=UTC
1m5.env=dev

# --- SEDA bus --------------------------------------------------------------
# Worker pool size: an integer, or "Platform" for (cores * 2).
ra.sedabus.pool.max=Platform

# --- Localhost Envelope-JSON API (for 1m5-desktop-java) ---------------------
# Not started by the skeleton Daemon yet - requires resolvingarchitecture:http-client
# (see TODO.md). Kept here as the intended contract: host,port,handler.
#ra.http.server.configs=1m5-api,api,127.0.0.1,2018,ra.http.EnvelopeJSONDataHandler
